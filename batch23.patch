+
+# ── the limit on edits ──────────────────────────────────────────────────────────────────────────
+
+def test_edits_are_limited_per_customer_and_recover(monkeypatch):
+    import api.account_routes as routes
+    monkeypatch.setattr(routes, "_policy_edits", {})
+    t0 = 1000.0
+    for i in range(routes.POLICY_EDITS):
